{
  "expo": {
    "name": "Tarisira",
    "slug": "tarisira",
    "scheme": "tarisira",
    "version": "1.0.0",
    "icon": "./assets/tarisira-app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/tarisira-app-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#005F3C"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tarisira.app",
      "infoPlist": {
        "CFBundleDisplayName": "Tarisira",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tarisira.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/tarisira-app-icon.png",
        "backgroundColor": "#005F3C"
      }
    },
    "web": {
      "favicon": "./assets/tarisira-app-icon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b01d3f9f-9280-42d1-adae-2cc1e09efacd"
      }
    },
    "owner": "fafies-team"
  }
}
