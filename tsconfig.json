{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "constants/**/*.ts",
    "context/**/*.ts",
    "utils/**/*.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    ".expo/**",
    "dist/**",
    "build/**"
  ]
}
